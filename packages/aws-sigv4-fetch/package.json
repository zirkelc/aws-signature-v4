{
  "name": "aws-sigv4-fetch",
  "version": "5.0.0",
  "description": "SignatureV4 fetch function implemented with the official AWS SDK",
  "keywords": [
    "aws",
    "aws-sdk",
    "aws-sigv4",
    "fetch",
    "sign",
    "signature",
    "signature-v4",
    "signaturev4",
    "signed",
    "sigv4"
  ],
  "homepage": "https://github.com/zirkelc/aws-sigv4/packages/aws-sigv4-fetch#readme",
  "bugs": {
    "url": "https://github.com/zirkelc/aws-sigv4/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zirkelc/aws-sigv4.git",
    "directory": "packages/aws-sigv4-fetch"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "dependencies": {
    "aws-sigv4-sign": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.974.0"
  },
  "engines": {
    "node": ">=20"
  }
}
