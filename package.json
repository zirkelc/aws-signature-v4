{
  "name": "aws-sigv4",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "vitest --project=unit/*",
    "test:e2e": "vitest --project=e2e/*",
    "test:cov": "pnpm test:unit --coverage.enabled --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=json",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "format": "oxfmt --write",
    "format:ci": "oxfmt --check",
    "release": "pnpm publish -r --provenance --no-git-checks"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@total-typescript/tsconfig": "^1.0.4",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-fetch": "^4.1.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pkg-pr-new": "^0.0.75",
    "tsdown": "^0.22.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
